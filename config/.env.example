# ============================================
# 个人数字分身 · 环境变量模板
# 复制为 .env 并填入真实值
# cp config/.env.example config/.env
# ============================================

# --- DeepSeek 大模型 ---
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# --- 阿里云 DashScope（Embedding + Rerank） ---
DASHSCOPE_API_KEY=sk-your-dashscope-api-key-here
EMBEDDING_MODEL=text-embedding-v4
RERANK_MODEL=gte-rerank-v2

# --- 管理员账号（首次启动自动创建） ---
# 以下弱口令/密钥故意与启动拒绝名单一致；复制后必须替换再启动。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# --- JWT 鉴权 ---
JWT_SECRET_KEY=personal-agent-default-jwt-secret-change-in-production-env
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --- 公网访问控制（公网部署前按 docs/SECURITY.md 配置） ---
ALLOW_REGISTRATION=false
ALLOW_ANONYMOUS_KB_ACCESS=false
CORS_ORIGINS=*

# --- 数据存储路径（容器内使用默认值即可） ---
CHROMA_PERSIST_DIR=./assets/chroma_db
UPLOAD_DIR=./assets/upload_docs
TEST_DATA_DIR=./assets/test_data

# --- 日志 ---
LOG_DIR=./logs
LOG_LEVEL=INFO

# --- 服务 ---
HOST=0.0.0.0
PORT=7860
